{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tongpin-hackathon-team-matcher",
  "main": "cloudflare_worker.py",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./web/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tongpin-hackathon-team-matcher-db",
      "database_id": "8079bb8b-240c-4482-a3e9-80a273170aa7",
      "migrations_dir": "migrations"
    }
  ]
}
